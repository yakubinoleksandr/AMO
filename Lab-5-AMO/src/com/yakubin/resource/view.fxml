<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.yakubin.Controller" stylesheets="@style.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Метод Гаусса (Варіант 26)" styleClass="header-label"/>

    <GridPane fx:id="matrixGrid" hgap="10" vgap="10" alignment="CENTER">
    </GridPane>

    <Button text="Розв'язати СЛАР" onAction="#handleSolve" styleClass="solve-button"/>

    <TextArea fx:id="resultArea" editable="false" prefHeight="150" promptText="Результати розрахунку..."/>
</VBox>