<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yakubin.Controller">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
    <children>
        <GridPane hgap="10.0" vgap="10.0">
            <Label text="a:" GridPane.rowIndex="0"/><TextField fx:id="txtA" text="1" GridPane.columnIndex="1"/>
            <Label text="b:" GridPane.rowIndex="1"/><TextField fx:id="txtB" text="3" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="k:" GridPane.rowIndex="2"/><TextField fx:id="txtK" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="n:" GridPane.rowIndex="3"/><TextField fx:id="txtN" text="10" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label text="x0:" GridPane.rowIndex="4"/><TextField fx:id="txtX0" text="1.3" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>
        <HBox spacing="10.0" alignment="CENTER">
            <Button onAction="#handleCalculate" text="Обчислити" />
            <Label fx:id="lblResult" text="Результат: ---" />
        </HBox>
        <Button maxWidth="Infinity" onAction="#handleShowGraphs" text="Відобразити графіки" />
    </children>
</VBox>